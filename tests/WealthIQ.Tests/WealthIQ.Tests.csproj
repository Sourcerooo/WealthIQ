<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WealthIQ.Application\WealthIQ.Application.csproj" />
    <ProjectReference Include="..\..\src\WealthIQ.Domain\WealthIQ.Domain.csproj" />
    <ProjectReference Include="..\..\src\WealthIQ.Infrastructure\WealthIQ.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Anchored to the project's own Fixtures folder. A leading "**\" here would also match
         bin\...\Fixtures (the copied output), recursively re-copying it deeper on every build —
         which previously exploded bin into ~880k nested files. Keep this anchored; never use "**\Fixtures". -->
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" Exclude="bin\**;obj\**" />
  </ItemGroup>

</Project>
