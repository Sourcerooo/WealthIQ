<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WealthIQ.Application\WealthIQ.Application.csproj" />
    <ProjectReference Include="..\..\src\WealthIQ.Domain\WealthIQ.Domain.csproj" />
    <ProjectReference Include="..\..\src\WealthIQ.Infrastructure\WealthIQ.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each path is anchored to a specific source folder — no leading "**\" — so the glob
         cannot match the copied output in bin/ and recursively re-copy it deeper on every build.
         (A leading "**\Fixtures" previously caused ~880k nested files in bin/.) -->
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Infrastructure\Import\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Infrastructure\ReferenceData\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
