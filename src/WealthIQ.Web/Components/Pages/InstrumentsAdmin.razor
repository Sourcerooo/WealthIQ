@page "/data-admin/instruments"
@using WealthIQ.Application.ReferenceData
@using WealthIQ.Application.ReferenceData.Interface
@using WealthIQ.Domain.Enumeration
@using CurrencyCode = WealthIQ.Domain.Enumeration.Currency
@inject IInstrumentReferenceAdmin Admin
@inject IDialogService DialogService

<PageTitle>WealthIQ — Instrumente verwalten</PageTitle>

<PageHeader Title="Instrumente" Subtitle="Instrumentenprofile und Listings pflegen">
    <Actions>
        <MudButton Variant="Variant.Text" Href="/data-admin" StartIcon="@Icons.Material.Outlined.ArrowBack">Zurück zu Marktdaten</MudButton>
    </Actions>
</PageHeader>

<div class="wiq-rise">

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }

    @if (_message is not null)
    {
        <MudAlert Severity="@_messageSeverity" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="DismissMessage">@_message</MudAlert>
    }

    <!-- Instruments Table -->
    <SectionCard Title="@($"Instrumente ({_instruments.Count})")">
        <HeaderActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                       Disabled="_busy || _editing" OnClick="StartAddNew">
                Neu hinzufügen
            </MudButton>
        </HeaderActions>
        <ChildContent>
            <MudTable Items="_instruments" Dense="true" Hover="true" Striped="true" Elevation="0"
                      FixedHeader="true" Height="520px">
                    <HeaderContent>
                        <MudTh>ISIN</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Typ</MudTh>
                        <MudTh>Teilfreistellung</MudTh>
                        <MudTh>Vorabpauschale</MudTh>
                        <MudTh># Listings</MudTh>
                        <MudTh>Aktionen</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ISIN">@context.Isin</MudTd>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Typ">@context.Type</MudTd>
                        <MudTd DataLabel="Teilfreistellung">@context.Teilfreistellungsquote.ToString("F2")</MudTd>
                        <MudTd DataLabel="Vorabpauschale">
                            @if (context.SubjectToVorabpauschale)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" />
                            }
                        </MudTd>
                        <MudTd DataLabel="# Listings">@context.Listings.Count</MudTd>
                        <MudTd DataLabel="Aktionen">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Bearbeiten"
                                           Disabled="_busy || _editing" OnClick="() => StartEdit(context)" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" aria-label="Löschen"
                                           Disabled="_busy || _editing" OnClick="() => DeleteInstrument(context.Isin)" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>Keine Instrumente vorhanden.</MudText>
                    </NoRecordsContent>
                </MudTable>
        </ChildContent>
    </SectionCard>

    <!-- Inline Edit / Add Panel -->
    @if (_editing && _editModel is not null)
    {
        <SectionCard Title="@(_isNew ? "Neues Instrument hinzufügen" : $"Bearbeiten: {_editModel.Isin}")">
            <ChildContent>
                <div class="d-flex gap-3 flex-wrap mb-3">
                    <MudTextField @bind-Value="_editModel.Isin" Label="ISIN" Variant="Variant.Outlined"
                                  ReadOnly="@(!_isNew)" Style="min-width: 200px;" />
                    <MudTextField @bind-Value="_editModel.Name" Label="Name" Variant="Variant.Outlined"
                                  Style="min-width: 280px;" />
                    <MudTextField @bind-Value="_editModel.Type" Label="Typ (z. B. ETF_EQUITY)" Variant="Variant.Outlined"
                                  Style="min-width: 200px;" />
                </div>

                <div class="d-flex gap-3 flex-wrap align-center mb-3">
                    <MudNumericField T="decimal" @bind-Value="_editModel.Teilfreistellungsquote"
                                     Label="Teilfreistellungsquote" Variant="Variant.Outlined"
                                     Step="0.05m" Min="0m" Max="1m" Format="F2"
                                     Style="min-width: 200px;" />
                    <MudCheckBox @bind-Value="_editModel.SubjectToVorabpauschale"
                                 Label="Vorabpauschale" />
                </div>

                <!-- Listings sub-editor -->
                <MudText Typo="Typo.subtitle2" Class="mb-2">Listings</MudText>
                @for (int i = 0; i < _editModel.Listings.Count; i++)
                {
                    var idx = i;
                    var listing = _editModel.Listings[idx];
                    <div style="border:1px solid var(--mud-palette-lines-default);border-radius:10px;padding:12px;margin-bottom:10px;">
                        <div class="d-flex gap-3 flex-wrap align-center">
                            <MudSelect T="CurrencyCode" @bind-Value="listing.Currency" Label="Währung"
                                       Variant="Variant.Outlined" Style="min-width: 120px;">
                                @foreach (var cur in Enum.GetValues<CurrencyCode>())
                                {
                                    <MudSelectItem T="CurrencyCode" Value="@cur">@cur</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="listing.ProviderSymbol" Label="Provider-Symbol"
                                          Variant="Variant.Outlined" Style="min-width: 160px;" />
                            <MudTextField @bind-Value="listing.Provider" Label="Provider"
                                          Variant="Variant.Outlined" Style="min-width: 160px;" />
                            <MudTextField @bind-Value="listing.Exchange" Label="Exchange (optional)"
                                          Variant="Variant.Outlined" Style="min-width: 140px;" />
                            <MudTextField @bind-Value="listing.Notes" Label="Notizen (optional)"
                                          Variant="Variant.Outlined" Style="min-width: 160px;" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Listing entfernen"
                                           Size="Size.Small" OnClick="() => RemoveListing(idx)" />
                        </div>
                    </div>
                }

                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add"
                           Class="mb-3" OnClick="AddListing">
                    Listing hinzuf&uuml;gen
                </MudButton>

                <MudDivider Class="my-3" />

                <div class="d-flex gap-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveEdit">
                        Speichern
                    </MudButton>
                    <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="CancelEdit">
                        Abbrechen
                    </MudButton>
                </div>
            </ChildContent>
        </SectionCard>
    }

    <!-- Upload Section -->
    <SectionCard Title="Import (JSON)">
        <ChildContent>
            <MudText Typo="Typo.body2" Class="mb-3">
                Instrumente und Listings aus JSON-Dateien hochladen (instruments.json / listings.json).
            </MudText>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="mb-1">instruments.json:</MudText>
                <InputFile OnChange="OnInstrumentsFileSelected" accept=".json" />
                @if (_instrumentsFileName is not null)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">Ausgewaehlt: @_instrumentsFileName</MudText>
                }
            </div>

            <div class="mb-3">
                <MudText Typo="Typo.caption" Class="mb-1">listings.json:</MudText>
                <InputFile OnChange="OnListingsFileSelected" accept=".json" />
                @if (_listingsFileName is not null)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">Ausgewaehlt: @_listingsFileName</MudText>
                }
            </div>

            <MudRadioGroup T="UploadMode" @bind-Value="_uploadMode" Class="mb-3">
                <MudRadio T="UploadMode" Value="UploadMode.Merge">Zusammenf&uuml;hren (Merge)</MudRadio>
                <MudRadio T="UploadMode" Value="UploadMode.Replace">Ersetzen (Replace)</MudRadio>
            </MudRadioGroup>

            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       Disabled="@(_busy || _instrumentsJson is null || _listingsJson is null)"
                       OnClick="RunUpload">
                Hochladen
            </MudButton>

            @if (_uploadResult is not null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">
                    Profile: @_uploadResult.Profiles | Listings: @_uploadResult.Listings
                    @if (_uploadResult.Warnings.Count > 0)
                    {
                        <br />
                        @foreach (var w in _uploadResult.Warnings)
                        {
                            <span>&#x26A0; @w<br /></span>
                        }
                    }
                </MudAlert>
            }
        </ChildContent>
    </SectionCard>

</div>

@code {
    // Mutable edit model for the inline editor
    private sealed class ListingEditModel
    {
        public CurrencyCode Currency { get; set; } = CurrencyCode.EUR;
        public string ProviderSymbol { get; set; } = "";
        public string Provider { get; set; } = "YahooFinance";
        public string? Exchange { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class InstrumentEditModel
    {
        public string Isin { get; set; } = "";
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
        public decimal Teilfreistellungsquote { get; set; } = 0m;
        public bool SubjectToVorabpauschale { get; set; } = false;

        // No editor control yet (Task 11 wires up the UI); carried through unchanged so this
        // page does not silently wipe a classification set elsewhere (import, seed, or the DB directly).
        public TaxAssetClass? AssetClass { get; set; }
        public List<ListingEditModel> Listings { get; set; } = new();
    }

    private bool _busy;
    private string? _message;
    private Severity _messageSeverity = Severity.Success;

    private List<InstrumentAdminDto> _instruments = new();

    // Edit state
    private bool _editing;
    private bool _isNew;
    private InstrumentEditModel? _editModel;

    // Upload state
    private string? _instrumentsJson;
    private string? _instrumentsFileName;
    private string? _listingsJson;
    private string? _listingsFileName;
    private UploadMode _uploadMode = UploadMode.Merge;
    private InstrumentUploadResult? _uploadResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstrumentsAsync();
    }

    private async Task LoadInstrumentsAsync()
    {
        _instruments = (await Admin.ListAsync()).ToList();
    }

    // ── Table actions ────────────────────────────────────────────────────────

    private void StartAddNew()
    {
        _editModel = new InstrumentEditModel();
        _isNew = true;
        _editing = true;
        _message = null;
    }

    private void StartEdit(InstrumentAdminDto dto)
    {
        _editModel = new InstrumentEditModel
        {
            Isin = dto.Isin,
            Name = dto.Name,
            Type = dto.Type,
            Teilfreistellungsquote = dto.Teilfreistellungsquote,
            SubjectToVorabpauschale = dto.SubjectToVorabpauschale,
            AssetClass = dto.AssetClass,
            Listings = dto.Listings.Select(l => new ListingEditModel
            {
                Currency = l.Currency,
                ProviderSymbol = l.ProviderSymbol,
                Provider = l.Provider,
                Exchange = l.Exchange,
                Notes = l.Notes
            }).ToList()
        };
        _isNew = false;
        _editing = true;
        _message = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editModel = null;
    }

    private async Task SaveEdit()
    {
        if (_editModel is null) return;

        _busy = true;
        try
        {
            var dto = new InstrumentAdminDto(
                _editModel.Isin,
                _editModel.Name,
                _editModel.Type,
                _editModel.Teilfreistellungsquote,
                _editModel.SubjectToVorabpauschale,
                _editModel.AssetClass,
                _editModel.Listings.Select(l => new InstrumentListingDto(
                    l.Currency,
                    l.ProviderSymbol,
                    l.Provider,
                    string.IsNullOrWhiteSpace(l.Exchange) ? null : l.Exchange,
                    string.IsNullOrWhiteSpace(l.Notes) ? null : l.Notes)).ToList());

            await Admin.SaveAsync(dto);
            await LoadInstrumentsAsync();
            _editing = false;
            _editModel = null;
            ShowSuccess($"Instrument {dto.Isin} gespeichert.");
        }
        catch (ArgumentException ex) { ShowError(ex.Message); }
        catch (Exception ex) { ShowError($"Fehler beim Speichern: {ex.Message}"); }
        finally { _busy = false; }
    }

    private async Task DeleteInstrument(string isin)
    {
        bool? confirmed;

        var isReferenced = await Admin.IsReferencedByLedgerAsync(isin);
        if (isReferenced)
        {
            confirmed = await DialogService.ShowMessageBoxAsync(
                "Instrument wird referenziert",
                $"Dieses Instrument ({isin}) wird vom Ledger referenziert. Trotzdem löschen?",
                yesText: "Trotzdem löschen", cancelText: "Abbrechen");
        }
        else
        {
            confirmed = await DialogService.ShowMessageBoxAsync(
                "Instrument löschen",
                $"Instrument {isin} wirklich löschen?",
                yesText: "Löschen", cancelText: "Abbrechen");
        }

        if (confirmed != true) return;

        _busy = true;
        try
        {
            await Admin.DeleteAsync(isin);
            await LoadInstrumentsAsync();
            ShowSuccess($"Instrument {isin} gelöscht.");
        }
        catch (Exception ex) { ShowError($"Fehler beim Löschen: {ex.Message}"); }
        finally { _busy = false; }
    }

    // ── Listing sub-editor ───────────────────────────────────────────────────

    private void AddListing()
    {
        _editModel?.Listings.Add(new ListingEditModel());
    }

    private void RemoveListing(int index)
    {
        if (_editModel is not null && index >= 0 && index < _editModel.Listings.Count)
            _editModel.Listings.RemoveAt(index);
    }

    // ── Upload ───────────────────────────────────────────────────────────────

    private async Task OnInstrumentsFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _instrumentsFileName = file.Name;
        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var reader = new System.IO.StreamReader(stream);
        _instrumentsJson = await reader.ReadToEndAsync();
    }

    private async Task OnListingsFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _listingsFileName = file.Name;
        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var reader = new System.IO.StreamReader(stream);
        _listingsJson = await reader.ReadToEndAsync();
    }

    private async Task RunUpload()
    {
        if (_instrumentsJson is null || _listingsJson is null) return;

        _busy = true;
        _uploadResult = null;
        try
        {
            var result = await Admin.UploadAsync(_instrumentsJson, _listingsJson, _uploadMode);
            _uploadResult = result;
            await LoadInstrumentsAsync();
            ShowSuccess($"Upload abgeschlossen: {result.Profiles} Profile, {result.Listings} Listings.");
        }
        catch (Exception ex) { ShowError($"Upload fehlgeschlagen: {ex.Message}"); }
        finally { _busy = false; }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private void DismissMessage() => _message = null;
    private void ShowSuccess(string msg) { _message = msg; _messageSeverity = Severity.Success; }
    private void ShowError(string msg) { _message = msg; _messageSeverity = Severity.Error; }
}
