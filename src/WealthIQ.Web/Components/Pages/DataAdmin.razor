@page "/data-admin"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using WealthIQ.Application.Currency
@using WealthIQ.Application.Import.Diagnostic
@using WealthIQ.Application.MarketData
@using WealthIQ.Application.ReferenceData
@using WealthIQ.Application.ReferenceData.Interface
@using WealthIQ.Application.Tax
@using WealthIQ.Infrastructure.Persistence
@inject WealthIqDbContext Db
@inject HistoricalPriceRefreshService PriceRefresh
@inject FxRateRefreshService FxRefresh
@inject BasisInterestRateRefreshService BasisRefresh
@inject ILedgerClearService LedgerClear
@inject IReferenceDataClearService RefClear
@inject IReferenceDataSeeder Seeder
@inject ReferenceDataSources Sources
@inject IDataRefreshLog RefreshLog
@inject IDialogService DialogService
@inject TimeProvider Clock

<PageTitle>WealthIQ — Datenverwaltung</PageTitle>

<PageHeader Title="Marktdaten" Subtitle="Kurse, Wechselkurse und Basiszins verwalten" />

<div class="wiq-rise">

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Class="mb-4" />
}

@if (_message is not null)
{
    <MudAlert Severity="@_messageSeverity" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="DismissMessage">@_message</MudAlert>
}

<MudExpansionPanels MultiExpansion="true" Elevation="0">

    <!-- Ledger -->
    <MudExpansionPanel Text="Ledger (Buchungen)" Icon="@Icons.Material.Outlined.Receipt">
        <MudText Typo="Typo.body2" Class="mb-3">
            Einträge: @_ledgerEntries | Konten: @_accounts | Batches: @_batches
        </MudText>
        <MudCheckBox @bind-Value="_purgeAuditFiles" Label="Rohdateien (Audit) löschen" />
        <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mt-2"
                   Disabled="_busy" OnClick="ClearLedger">
            Ledger leeren (unwiderruflich)
        </MudButton>
    </MudExpansionPanel>

    <!-- Historical Prices -->
    <MudExpansionPanel Text="Historische Kurse (Yahoo Finance)" Icon="@Icons.Material.Outlined.ShowChart">
        <MudText Typo="Typo.body2" Class="mb-3">
            @if (_priceMin is not null && _priceMax is not null)
            {
                <span>Zeitraum: @_priceMin?.ToString("yyyy-MM-dd") – @_priceMax?.ToString("yyyy-MM-dd") | @_priceSymbols Instrumente | @_priceCount Bars</span>
            }
            else
            {
                <span>keine Daten</span>
            }
            <span> | Zuletzt aktualisiert: @(_priceLastRefreshed?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
        </MudText>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mr-2 mb-2"
                   Disabled="_busy" OnClick="RefreshPricesIncremental">
            Inkrementell aktualisieren (alle)
        </MudButton>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Gezielter Download</MudText>

        <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_selectedSymbols"
                   Label="Instrumente" Variant="Variant.Outlined" Class="mb-3"
                   SelectAll="true" SelectAllText="Alle auswählen">
            @foreach (var sym in _availableSymbols)
            {
                <MudSelectItem T="string" Value="@sym.ProviderSymbol">@sym.ProviderSymbol (@sym.Currency)</MudSelectItem>
            }
        </MudSelect>

        <MudDateRangePicker @bind-DateRange="_priceRange" Label="Zeitraum" Variant="Variant.Outlined" Class="mb-3" />

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mr-2 mb-2"
                   Disabled="_busy" OnClick="RefreshPricesRange">
            Herunterladen
        </MudButton>

        <MudDivider Class="my-3" />

        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Class="mr-2 mb-2"
                   Disabled="_busy" OnClick="ClearHistoricalPrices">
            Löschen
        </MudButton>
        <MudButton Variant="Variant.Outlined" Class="mb-2"
                   Disabled="_busy" OnClick="ReseedHistoricalPrices">
            Aus Datei neu laden
        </MudButton>
    </MudExpansionPanel>

    <!-- FX Rates -->
    <MudExpansionPanel Text="Wechselkurse (EZB)" Icon="@Icons.Material.Outlined.CurrencyExchange">
        <MudText Typo="Typo.body2" Class="mb-3">
            @if (_fxMin is not null && _fxMax is not null)
            {
                <span>Zeitraum: @_fxMin?.ToString("yyyy-MM-dd") – @_fxMax?.ToString("yyyy-MM-dd") | @_fxCurrencies Währungen</span>
            }
            else
            {
                <span>keine Daten</span>
            }
            <span> | Zuletzt aktualisiert: @(_fxLastRefreshed?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
        </MudText>

        <MudDateRangePicker @bind-DateRange="_fxRange" Label="Zeitraum" Variant="Variant.Outlined" Class="mb-3" />

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mr-2 mb-2"
                   Disabled="_busy" OnClick="RefreshFxRates">
            Von EZB aktualisieren
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Class="mr-2 mb-2"
                   Disabled="_busy" OnClick="ClearFxRates">
            Löschen
        </MudButton>
        <MudButton Variant="Variant.Outlined" Class="mb-2"
                   Disabled="_busy" OnClick="ReseedFxRates">
            Aus Datei neu laden
        </MudButton>
    </MudExpansionPanel>

    <!-- Basiszins -->
    <MudExpansionPanel Text="Basiszins (BMF)" Icon="@Icons.Material.Outlined.Percent">
        <MudText Typo="Typo.body2" Class="mb-3">
            @if (_basiszinsMin is not null && _basiszinsMax is not null)
            {
                <span>Jahre: @_basiszinsMin – @_basiszinsMax | @_basiszinsCount Einträge</span>
            }
            else
            {
                <span>keine Daten</span>
            }
            <span> | Zuletzt aktualisiert: @(_basiszinsLastRefreshed?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
        </MudText>

        <MudNumericField T="int" @bind-Value="_basisYear" Label="Jahr" Variant="Variant.Outlined" Class="mb-3" Style="max-width: 160px;" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mr-2 mb-2"
                   Disabled="_busy" OnClick="RefreshBasiszins">
            Von BMF abrufen
        </MudButton>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Manuell erfassen</MudText>
        <div class="d-flex gap-3 align-center flex-wrap mb-3">
            <MudNumericField T="int" @bind-Value="_manualYear" Label="Jahr" Variant="Variant.Outlined" Style="max-width: 160px;" />
            <MudNumericField T="decimal" @bind-Value="_manualRate" Label="Zinssatz (z. B. 0,0253)" Variant="Variant.Outlined" Style="max-width: 220px;" Format="F4" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       Disabled="_busy" OnClick="SaveManualBasiszins">
                Speichern
            </MudButton>
        </div>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Gespeicherte Werte</MudText>
        @if (_basiszinsRows.Count == 0)
        {
            <MudText Typo="Typo.body2">Keine Einträge.</MudText>
        }
        else
        {
            <MudTable Items="_basiszinsRows" Dense="true" Hover="true" Elevation="0"
                      CanCancelEdit="true" RowEditCommit="@(async (obj) => await CommitBasiszinsEdit(obj))" T="BasiszinsRow"
                      Class="mb-2" Style="max-width:480px;">
                <HeaderContent>
                    <MudTh>Jahr</MudTh>
                    <MudTh Style="text-align:right">Zinssatz</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Jahr">@context.Year</MudTd>
                    <MudTd DataLabel="Zinssatz" Style="text-align:right">@context.Rate.ToString("F4")</MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                       Disabled="_busy" OnClick="() => DeleteBasiszins(context.Year)" aria-label="Löschen" />
                    </MudTd>
                </RowTemplate>
                <RowEditingTemplate>
                    <MudTd DataLabel="Jahr">@context.Year</MudTd>
                    <MudTd DataLabel="Zinssatz">
                        <MudNumericField @bind-Value="context.Rate" Format="F4" Variant="Variant.Text" Style="max-width:160px;" />
                    </MudTd>
                    <MudTd></MudTd>
                </RowEditingTemplate>
            </MudTable>
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                Zeile anklicken zum Bearbeiten des Zinssatzes. Neue Jahre über „Manuell erfassen" oder „Von BMF abrufen".
            </MudText>
        }

        <MudDivider Class="my-3" />

        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Class="mr-2 mb-2"
                   Disabled="_busy" OnClick="ClearBasiszins">
            Löschen
        </MudButton>
        <MudButton Variant="Variant.Outlined" Class="mb-2"
                   Disabled="_busy" OnClick="ReseedBasiszins">
            Aus Datei neu laden
        </MudButton>
    </MudExpansionPanel>

    <!-- Instruments -->
    <MudExpansionPanel Text="Instrumente" Icon="@Icons.Material.Outlined.Inventory2">
        <MudText Typo="Typo.body2" Class="mb-3">
            Profile: @_profileCount | Listings: @_listingCount
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/data-admin/instruments" StartIcon="@Icons.Material.Outlined.OpenInNew">Instrumente verwalten</MudButton>
    </MudExpansionPanel>

</MudExpansionPanels>

@if (_lastResult is not null)
{
    <div class="mt-4">
    <SectionCard Title="Ergebnis">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@_lastResultLabel</MudText>
        <MudText Typo="Typo.body2">
            Hinzugefügt: @_lastResult.Added, Aktualisiert: @_lastResult.Updated, Übersprungen: @_lastResult.Skipped
        </MudText>
        @if (_lastResult.Diagnostics.Count > 0)
        {
            <MudTable Items="_lastResult.Diagnostics" Dense="true" Hover="true" Elevation="0" Class="mt-3">
                <HeaderContent>
                    <MudTh>Severity</MudTh>
                    <MudTh>Code</MudTh>
                    <MudTh>Meldung</MudTh>
                    <MudTh>Sektion</MudTh>
                    <MudTh>Referenz</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Severity">@context.Severity</MudTd>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    <MudTd DataLabel="Meldung">@context.Message</MudTd>
                    <MudTd DataLabel="Sektion">@context.Section</MudTd>
                    <MudTd DataLabel="Referenz">@context.SourceReference</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </SectionCard>
    </div>
}

</div>

@code {
    private bool _busy;
    private bool _purgeAuditFiles;
    private string? _message;
    private Severity _messageSeverity = Severity.Success;

    // status counts
    private int _ledgerEntries, _accounts, _batches;
    private int _priceCount, _priceSymbols;
    private DateOnly? _priceMin, _priceMax;
    private int _fxCurrencies;
    private DateOnly? _fxMin, _fxMax;
    private int? _basiszinsMin, _basiszinsMax;
    private int _basiszinsCount, _profileCount, _listingCount;
    private DateTimeOffset? _priceLastRefreshed, _fxLastRefreshed, _basiszinsLastRefreshed;

    // price multiselect
    private IReadOnlyCollection<string> _selectedSymbols = Array.Empty<string>();
    private List<(string ProviderSymbol, string Currency)> _availableSymbols = new();
    private DateRange? _priceRange;

    // fx range
    private DateRange? _fxRange;

    // basiszins inputs
    private int _basisYear;
    private int _manualYear;
    private decimal _manualRate;

    public sealed class BasiszinsRow
    {
        public int Year { get; set; }
        public decimal Rate { get; set; }
    }

    private List<BasiszinsRow> _basiszinsRows = new();

    // last refresh result
    private DataRefreshResult? _lastResult;
    private string _lastResultLabel = "";

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        _priceRange = new DateRange(today.AddYears(-5), today);
        _fxRange = new DateRange(today.AddYears(-5), today);
        _basisYear = Clock.GetUtcNow().Year;
        _manualYear = Clock.GetUtcNow().Year;
        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        _ledgerEntries = await Db.PortfolioEntries.CountAsync();
        _accounts = await Db.Accounts.CountAsync();
        _batches = await Db.ImportBatches.CountAsync();

        _priceCount = await Db.HistoricalPrices.CountAsync();
        if (_priceCount > 0)
        {
            _priceMin = await Db.HistoricalPrices.MinAsync(x => x.Date);
            _priceMax = await Db.HistoricalPrices.MaxAsync(x => x.Date);
            _priceSymbols = await Db.HistoricalPrices.Select(x => x.ProviderSymbol).Distinct().CountAsync();
        }
        else
        {
            _priceMin = null;
            _priceMax = null;
            _priceSymbols = 0;
        }

        var fxCount = await Db.FxRates.CountAsync();
        if (fxCount > 0)
        {
            _fxMin = await Db.FxRates.MinAsync(x => x.Date);
            _fxMax = await Db.FxRates.MaxAsync(x => x.Date);
            _fxCurrencies = await Db.FxRates.Select(x => x.Currency).Distinct().CountAsync();
        }
        else
        {
            _fxMin = null;
            _fxMax = null;
            _fxCurrencies = 0;
        }

        _basiszinsCount = await Db.BasisInterestRates.CountAsync();
        if (_basiszinsCount > 0)
        {
            _basiszinsMin = await Db.BasisInterestRates.MinAsync(x => x.Year);
            _basiszinsMax = await Db.BasisInterestRates.MaxAsync(x => x.Year);
        }
        else
        {
            _basiszinsMin = null;
            _basiszinsMax = null;
        }

        _basiszinsRows = await Db.BasisInterestRates
            .OrderByDescending(x => x.Year)
            .Select(x => new BasiszinsRow { Year = x.Year, Rate = x.Rate })
            .ToListAsync();

        _profileCount = await Db.InstrumentProfiles.CountAsync();
        _listingCount = await Db.InstrumentListings.CountAsync();

        _priceLastRefreshed = await RefreshLog.GetLastRefreshedAsync("HistoricalPrices");
        _fxLastRefreshed = await RefreshLog.GetLastRefreshedAsync("FxRates");
        _basiszinsLastRefreshed = await RefreshLog.GetLastRefreshedAsync("Basiszins");

        _availableSymbols = await Db.InstrumentListings
            .Select(x => new { x.ProviderSymbol, x.Currency })
            .Distinct()
            .OrderBy(x => x.ProviderSymbol)
            .ToListAsync()
            .ContinueWith(t => t.Result.Select(x => (x.ProviderSymbol, x.Currency)).ToList());
    }

    private async Task ClearLedger()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Ledger wirklich löschen?",
            "Alle Buchungen, Konten, Import-Batches und Diagnosen werden unwiderruflich gelöscht. Referenz-/Marktdaten bleiben erhalten.",
            yesText: "Endgültig löschen", cancelText: "Abbrechen");
        if (confirmed != true) return;

        _busy = true;
        try
        {
            await LedgerClear.ClearLedgerAsync(_purgeAuditFiles);
            ShowSuccess("Ledger geleert.");
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RefreshPricesIncremental()
    {
        _busy = true;
        _lastResult = null;
        try
        {
            var result = await PriceRefresh.RefreshAsync(Today(), false, default);
            _lastResult = result;
            _lastResultLabel = "Historische Kurse (inkrementell)";
            if (!result.HasBlockingDiagnostics)
            {
                await RefreshLog.RecordAsync("HistoricalPrices", Clock.GetUtcNow(),
                    $"{result.Added} neu, {result.Updated} aktualisiert");
                ShowSuccess($"Kurse aktualisiert: {result.Added} neu, {result.Updated} aktualisiert.");
            }
            else
            {
                ShowError("Refresh abgeschlossen, aber mit Fehlern (siehe Diagnosetabelle).");
            }
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RefreshPricesRange()
    {
        _busy = true;
        _lastResult = null;
        try
        {
            var symbols = _selectedSymbols.ToList();
            var result = await PriceRefresh.RefreshRangeAsync(
                symbols.Count > 0 ? symbols : null,
                From(_priceRange), To(_priceRange), false, default);
            _lastResult = result;
            _lastResultLabel = "Historische Kurse (gezielt)";
            if (!result.HasBlockingDiagnostics)
            {
                await RefreshLog.RecordAsync("HistoricalPrices", Clock.GetUtcNow(),
                    $"{result.Added} neu, {result.Updated} aktualisiert");
                ShowSuccess($"Kurse heruntergeladen: {result.Added} neu, {result.Updated} aktualisiert.");
            }
            else
            {
                ShowError("Refresh abgeschlossen, aber mit Fehlern (siehe Diagnosetabelle).");
            }
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RefreshFxRates()
    {
        _busy = true;
        _lastResult = null;
        try
        {
            var result = await FxRefresh.RefreshAsync(From(_fxRange), To(_fxRange), default);
            _lastResult = result;
            _lastResultLabel = "Wechselkurse (EZB)";
            if (!result.HasBlockingDiagnostics)
            {
                await RefreshLog.RecordAsync("FxRates", Clock.GetUtcNow(),
                    $"{result.Added} neu, {result.Updated} aktualisiert");
                ShowSuccess($"Wechselkurse aktualisiert: {result.Added} neu, {result.Updated} aktualisiert.");
            }
            else
            {
                ShowError("Refresh abgeschlossen, aber mit Fehlern (siehe Diagnosetabelle).");
            }
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RefreshBasiszins()
    {
        _busy = true;
        _lastResult = null;
        try
        {
            var result = await BasisRefresh.RefreshAsync(_basisYear, default);
            _lastResult = result;
            _lastResultLabel = $"Basiszins {_basisYear} (BMF)";
            if (!result.HasBlockingDiagnostics)
            {
                await RefreshLog.RecordAsync("Basiszins", Clock.GetUtcNow(),
                    $"Jahr {_basisYear}: {result.Added} neu, {result.Updated} aktualisiert");
                ShowSuccess($"Basiszins {_basisYear} abgerufen.");
            }
            else
            {
                ShowError($"Basiszins {_basisYear} konnte nicht abgerufen werden (siehe Diagnosetabelle). Bitte manuell erfassen.");
            }
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task SaveManualBasiszins()
    {
        _busy = true;
        _lastResult = null;
        try
        {
            await BasisRefresh.SetManualAsync(_manualYear, _manualRate, default);
            await RefreshLog.RecordAsync("Basiszins", Clock.GetUtcNow(),
                $"Manuell: Jahr {_manualYear} = {_manualRate:F4}");
            ShowSuccess($"Basiszins {_manualYear} = {_manualRate:F4} gespeichert.");
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task CommitBasiszinsEdit(object element)
    {
        var row = (BasiszinsRow)element;
        _busy = true;
        try
        {
            await BasisRefresh.SetManualAsync(row.Year, row.Rate, default);
            await RefreshLog.RecordAsync("Basiszins", Clock.GetUtcNow(), $"Bearbeitet: Jahr {row.Year} = {row.Rate:F4}");
            ShowSuccess($"Basiszins {row.Year} = {row.Rate:F4} gespeichert.");
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task DeleteBasiszins(int year)
    {
        _busy = true;
        try
        {
            await BasisRefresh.DeleteAsync(year, default);
            await RefreshLog.RecordAsync("Basiszins", Clock.GetUtcNow(), $"Gelöscht: Jahr {year}");
            ShowSuccess($"Basiszins {year} gelöscht.");
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task ClearHistoricalPrices() => await ClearDataset(ReferenceDataset.HistoricalPrices, "Kursdaten geleert.");
    private async Task ClearFxRates() => await ClearDataset(ReferenceDataset.FxRates, "Wechselkurse geleert.");
    private async Task ClearBasiszins() => await ClearDataset(ReferenceDataset.BasisInterestRates, "Basiszins geleert.");

    private async Task ClearDataset(ReferenceDataset dataset, string successMessage)
    {
        _busy = true;
        try
        {
            await RefClear.ClearAsync(dataset);
            ShowSuccess(successMessage);
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private async Task ReseedHistoricalPrices() => await Reseed(ReferenceDataset.HistoricalPrices, "Historische Kurse");
    private async Task ReseedFxRates() => await Reseed(ReferenceDataset.FxRates, "Wechselkurse");
    private async Task ReseedBasiszins() => await Reseed(ReferenceDataset.BasisInterestRates, "Basiszins");

    private async Task Reseed(ReferenceDataset dataset, string label)
    {
        _busy = true;
        try
        {
            await RefClear.ClearAsync(dataset);
            await Seeder.SeedIfEmptyAsync(Sources);
            ShowSuccess($"{label} aus Seed-Dateien neu geladen.");
            await LoadStatusAsync();
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _busy = false; }
    }

    private void DismissMessage() => _message = null;
    private void ShowSuccess(string msg) { _message = msg; _messageSeverity = Severity.Success; }
    private void ShowError(string msg) { _message = msg; _messageSeverity = Severity.Error; }

    private DateOnly Today() => DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
    private static DateOnly From(DateRange? r) => DateOnly.FromDateTime(r?.Start ?? DateTime.UtcNow.AddYears(-5));
    private static DateOnly To(DateRange? r) => DateOnly.FromDateTime(r?.End ?? DateTime.UtcNow);
}
